@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
    ViewData["hidePageHeader"] = true;
}

<div class="d-flex justify-content-center py-10">
    <div class="card text-center" style="max-width:520px;width:100%">
        <div class="card-body p-8">
            <span class="sc-page-icon mx-auto mb-4" style="color:#ff4c51;background:rgba(255,76,81,.1)"><i class="ri-error-warning-line"></i></span>
            <h4 class="mb-2">Something went wrong</h4>
            <p class="text-muted mb-5">An error occurred while processing your request. Please try again, or go back to the dashboard.</p>
            @if (Model.ShowRequestId)
            {
                <p class="small text-muted mb-5">Request ID: <code>@Model.RequestId</code></p>
            }
            <a asp-page="/Index" class="btn btn-primary"><i class="ri-home-5-line me-1"></i>Back to dashboard</a>
        </div>
    </div>
</div>
