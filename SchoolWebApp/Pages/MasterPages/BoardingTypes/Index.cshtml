@page
@model SchoolWebApp.Pages.MasterPages.BoardingTypes.IndexModel
@{
}
@{
    ViewData["Title"] = "Boarding Types";
}

@section VendorStyles
{
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/&#64;form-validation/form-validation.dist.css" />
}
@section VendorScripts {
    <script src="~/vendor/libs/moment/moment.dist.js"></script>
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.dist.js"></script>
    <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/popular.dist.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/bootstrap5.dist.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/auto-focus.dist.js"></script>
    <script src="~/vendor/libs/cleavejs/cleave.dist.js"></script>
    <script src="~/vendor/libs/cleavejs/cleave-phone.dist.js"></script>
}

@section PageScripts {
    <script src="~/code_js/manageboardingtypes.js"></script>
}

<div class="card">
    <div class="card-header pb-0 d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Manage Boarding Types</h5>
      
    </div>

    <div class="card-datatable table-responsive">
        
        <table class="table" id="boardingTypeTable">
            <thead>
                <tr>
                    <th>S.No</th>
                    <th>Boarding Type</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.BoardingTypesList != null && Model.BoardingTypesList.Any())
                {
                    var sno = 0;
                    foreach (var type in Model.BoardingTypesList)
                    {
                        sno++;
                        var rowClass = "boardingtype-name-" + type.BoardingTypeID;
                        <tr data-id="@type.BoardingTypeID">
                            <td>@sno</td>
                            <td class="@rowClass">@type.BoardingType</td>
                            <td>
                                <!-- Edit Button -->
                                <button class="btn btn-sm btn-icon"
                                        data-bs-toggle="offcanvas"
                                        data-bs-target="#editBoardingTypeOffcanvas"
                                        onclick="editBoardingType(@type.BoardingTypeID)"
                                        data-id="@type.BoardingTypeID">
                                    <i class="ri-edit-box-line ri-20px"></i>
                                </button>

                                <!-- Edit Offcanvas -->
                                <div class="offcanvas offcanvas-end" tabindex="-1" id="editBoardingTypeOffcanvas" aria-labelledby="editBoardingTypeOffcanvasLabel">
                                    <div class="offcanvas-header">
                                        <h5 id="editBoardingTypeOffcanvasLabel" class="offcanvas-title">Edit Boarding Type</h5>
                                        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                                    </div>
                                    <div class="offcanvas-body">
                                        <div id="editBoardingTypeFormContainer"></div>
                                    </div>
                                </div>

                                <!-- Delete Button -->
                                <form method="post" id="deleteBoardingTypeForm-@type.BoardingTypeID" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@type.BoardingTypeID" />
                                    <button type="button" class="btn btn-sm btn-icon" onclick="showDeleteBoardingTypeConfirmation('@type.BoardingTypeID')">
                                        <i class="ri-delete-bin-7-line ri-20px"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Offcanvas -->
@await Html.PartialAsync("_Create")
