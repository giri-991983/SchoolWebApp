

@model SchoolWebApp.Pages.MasterPages.State.IndexModel

<div class="offcanvas offcanvas-end" tabindex="-1" id="createStateOffcanvas" aria-labelledby="createStateOffcanvasLabel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="createStateOffcanvasLabel">Add State Details</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body mx-0 flex-grow-0">
        <form id="addStateForm" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="State.StateID" />

         

            <div class="form-floating form-floating-outline mb-5">
                <select asp-for="State.CountryID" class="form-select" id="ModelCountryID" required>
                   
                    @await Component.InvokeAsync("Master", new { viewname = "Countries" })
                </select>
                <label for="CountryID">Country</label>
               
            </div>
            <div class="form-floating form-floating-outline mb-5">
                <input asp-for="State.StateName" autocomplete="off" class="form-control" id="StateName" placeholder="State Name" required />
                <label for="StateName">State Name</label>
               
            </div>
            <div class="row">
                <div class="col-12 text-end">
                    <button type="reset" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">Cancel</button>
                    <button type="submit" class="btn btn-primary me-3">Submit</button>
                </div>
            </div>
        </form>
    </div>
</div>