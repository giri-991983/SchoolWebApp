
@model SchoolWebApp.Models.State

<form id="editStateForm" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" name="StateID" value="@Model.StateID" />
    <div class="form-floating form-floating-outline mb-4">
        <select name="CountryID" class="form-select" id="EditCountryID" required>

            @await Component.InvokeAsync("Master", new { viewname = "Countries", SelectedIDs = Model.CountryID })
        </select>
        <label for="EditCountryID">Country</label>
        
    </div>
    <div class="form-floating form-floating-outline mb-4">
        <input type="text" class="form-control" id="EditStateName" name="StateName" value="@Model.StateName" placeholder="State Name" required />
        <label for="EditStateName">State Name</label>
      
    </div>

   

    <div class="text-end">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">Cancel</button>
        <button type="submit" class="btn btn-primary me-2">Save</button>
    </div>
</form>