@page
@model SchoolWebApp.Pages.MasterPages.FeePaymentMode.IndexModel

@{
    ViewData["Title"] = "Fee Payment Modes";
}

@section VendorStyles
{
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/&#64;form-validation/form-validation.dist.css" />
    <link href="~/vendor/libs/select2/select2.dist.css" rel="stylesheet" />


}

@section VendorScripts {
    <script src="~/vendor/libs/moment/moment.dist.js"></script>
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.dist.js"></script>
    <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/popular.dist.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/bootstrap5.dist.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/auto-focus.dist.js"></script>
    <script src="~/vendor/libs/cleavejs/cleave.dist.js"></script>
    <script src="~/vendor/libs/cleavejs/cleave-phone.dist.js"></script>
    <script src="~/vendor/libs/select2/select2.dist.js"></script>

}



@section PageScripts
{
    <script src="~/code_js/feepayment.js"></script>
}


<div class="card">
    <div class="card-header pb-0">
        <h5 class="card-title mb-0">Manage Fee Payment Modes</h5>
    </div>

    <div class="card-datatable table-responsive">
        <table id="FeePaymentTable" class="table">
            <thead>
                <tr>
                    <th>S.No</th>
                    <th>Fee Payment Mode</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model?.FeePaymentModesList != null && Model.FeePaymentModesList.Any())
                {
                    var serial = 0;
                    foreach (var item in Model.FeePaymentModesList)
                    {
                        serial++;

                        <tr data-id="@item.FeePaymentModeID">
                            <td>@serial</td>
                            <td>@item.FeePaymentMode</td>
                            <td class="text-nowrap">
                                <div class="d-flex gap-1">

                                    <!-- Edit Button -->
                                    <button type="button"
                                            class="btn btn-sm btn-icon"
                                            onclick="feePaymentEdit(@item.FeePaymentModeID)"
                                            data-bs-toggle="offcanvas"
                                            data-bs-target="#editFeePaymentOffcanvas">
                                        <i class="ri-edit-box-line ri-20px"></i>
                                    </button>

                                    <!-- Delete Button -->
                                    <button type="button"
                                            class="btn btn-sm btn-icon"
                                            onclick="feePaymentDelete(@item.FeePaymentModeID)">
                                        <i class="ri-delete-bin-7-line ri-20px"></i>
                                    </button>

                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td></td>
                        <td class="text-center">No Fee Payment Modes found.</td>
                        <td></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Offcanvas -->
@await Html.PartialAsync("_Create")

<!-- Edit Offcanvas -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="editFeePaymentOffcanvas" aria-labelledby="editFeePaymentOffcanvasLabel">
    <div class="offcanvas-header border-bottom">
        <h5 id="editFeePaymentOffcanvasLabel" class="offcanvas-title">Edit Fee Payment Mode</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <div class="offcanvas-body mx-0 flex-grow-0">
        <div id="editFeePaymentFormContainer">
            <!-- Loaded via AJAX -->
        </div>
    </div>
</div>

