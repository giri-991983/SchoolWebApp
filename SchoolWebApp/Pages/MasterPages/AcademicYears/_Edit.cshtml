@model SchoolWebApp.Pages.MasterPages.AcademicYears.IndexModel

<form id="editAcademicYearForm" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="AcademicYear.AcademicYearID" value="@Model.AcademicYear.AcademicYearID" />

    <div class="form-floating form-floating-outline mb-4">
        <input type="text"
               id="editAcademicYear"
               name="AcademicYear.AcademicYear"
               class="form-control"
               value="@Model.AcademicYear.AcademicYear"
               required
               maxlength="50"
               placeholder="Enter Academic Year (e.g., 2025-2026)" />
        <label for="editAcademicYear">Academic Year</label>
        <div id="editacademicYearValidationMessage" class="invalid-feedback d-block"></div>
    </div>

    <div class="text-end">
        <button type="submit" class="btn btn-success" id="saveAcademicYearBtn">Save</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="offcanvas">Cancel</button>
    </div>
</form>
