@page
@model SchoolWebApp.Pages.MasterPages.AcademicYears.IndexModel
@{
    ViewData["Title"] = "Manage Academic Years";
}  
@section VendorStyles
{
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/&#64;form-validation/form-validation.dist.css" />
    <link href="~/vendor/libs/select2/select2.dist.css" rel="stylesheet" />


}

@section VendorScripts {
    <script src="~/vendor/libs/moment/moment.dist.js"></script>
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.dist.js"></script>
    <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/popular.dist.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/bootstrap5.dist.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/auto-focus.dist.js"></script>
    <script src="~/vendor/libs/cleavejs/cleave.dist.js"></script>
    <script src="~/vendor/libs/cleavejs/cleave-phone.dist.js"></script>
    <script src="~/vendor/libs/select2/select2.dist.js"></script>

}


@section PageScripts
{
    
    <script src="~/code_js/manageacademicyear.js"></script>

}


<div class="card">
    <div class="card-datatable table-responsive">
        <div class="container-fluid">
            <h3 class="mb-4">Manage Academic Years</h3>
            <table id="AcademicYearTable" class="table">
                <thead>
                    <tr>
                        <th>S.No</th>
                        <th>Academic Year</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.AcademicYears != null && Model.AcademicYears.Any())
                    {
                        var serial = 0;
                        foreach (var item in Model.AcademicYears)
                        {
                            serial++;
                            var tcc = "academicyear-name-full-" + item.AcademicYearID;
                            <tr data-id="@item.AcademicYearID">
                                <td>@serial</td>
                                <td class="@tcc">@item.AcademicYear</td>
                                <td class="text-nowrap">
                                    <div class="col-md-12 d-flex gap-1">
                                        <button type="button"
                                                class="btn btn-sm btn-icon edit-academicyear-btn"
                                                onclick="academicYearEdit(@item.AcademicYearID)"
                                                data-academicyear-id="@item.AcademicYearID">
                                            <i class="ri-edit-box-line ri-20px"></i>
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-icon"
                                                onclick="showDeleteConfirmation(@item.AcademicYearID)">
                                            <i class="ri-delete-bin-7-line ri-20px"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center">No Academic Years found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="editAcademicYearModal" tabindex="-1" aria-labelledby="editAcademicYearModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editAcademicYearModalLabel">Edit Academic Year Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="editAcademicYearFormContainer">
                <!-- Loaded dynamically via AJAX -->
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("~/Pages/MasterPages/AcademicYears/_Create.cshtml", Model.AcademicYear)