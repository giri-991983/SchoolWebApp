@model SchoolWebApp.Models.Board
<form id="editBoardForm" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
   
        <input type="hidden" name="boardId" id="editBoardId" value="@Model.BoardID" />
    <div class="form-floating form-floating-outline mb-4">
     
   
            <input type="hidden" id="editCampusTypeID" name="campusTypeId" value="@Model.CampusTypeID" />
   </div>
    <div class="form-floating form-floating-outline mb-4">
        <input type="text"
               class="form-control"
               id="editBoardName"
               name="boardName"
               value="@Model.BoardName"
               placeholder="Board Name"
               required />
        <label for="editBoardName">Board Name</label>
        <div id="boardNameValidationMessage" class="invalid-feedback d-block"></div>
    </div>
    
    <div class="text-end">
        <button type="submit" class="btn btn-primary me-2">Save</button>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">Cancel</button>
    </div>
</form>

    