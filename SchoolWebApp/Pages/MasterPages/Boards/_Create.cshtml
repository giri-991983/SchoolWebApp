 @model SchoolWebApp.Pages.MasterPages.Boards.IndexModel
<div class="offcanvas offcanvas-end" tabindex="-1" id="createBoardOffcanvas" aria-labelledby="createBoardOffcanvasLabel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="createBoardOffcanvasLabel">Add Board Details</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body mx-0 flex-grow-0">
        <form id="addBoardForm" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="form-floating form-floating-outline mb-5">
                <select class="form-select" id="ModalCampusTypeID" name="campusTypeId" required>
                   
                    @await Component.InvokeAsync("Master", new { viewname = "CampusTypes" })
                </select>
                <label for="ModalCampusTypeID">Campus Type</label>
               
            </div>

            <div class="form-floating form-floating-outline mb-5">
                <input type="text" class="form-control" id="ModalBoardName" name="boardName" placeholder="Board Name" maxlength="100" required />
                <label for="ModalBoardName">Board Name</label>
                <span class="text-danger" id="boardNameValidationMessage"></span>
            </div>

            <div class="row">
                <div class="col-12">
                    <button type="submit" class="btn btn-primary me-3">Submit</button>
                    <button type="reset" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">Cancel</button>
                </div>
            </div>
        </form>
    </div>
</div>
