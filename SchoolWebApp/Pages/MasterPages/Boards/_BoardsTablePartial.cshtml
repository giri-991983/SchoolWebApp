@model IEnumerable<SchoolWebApp.Models.Board>
<table id="BoardTable" class="table">
    <thead>
        <tr>
            <th>S.No</th>
            <th>Board Name</th>          
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            var serial = 0;
            @foreach (var item in Model)
            {
                serial++;
                <tr data-id="@item.BoardID">
                    <td>@serial</td>
                    <td>@item.BoardName</td>                   
                    <td class="text-nowrap">
                        <div class="col-md-12">
                            <!-- Edit Button -->
                            <button class="btn btn-sm btn-icon edit-board-btn" onclick="boardEdit(@item.BoardID)" data-board-id="@item.BoardID">
                                <i class="ri-edit-box-line ri-20px"></i>
                            </button>
                            <div class="offcanvas offcanvas-end" tabindex="-1" id="editBoardOffcanvas" aria-labelledby="editBoardOffcanvasLabel">
                                <div class="offcanvas-header">
                                    <h5 id="editBoardOffcanvasLabel" class="offcanvas-title">Edit Board</h5>
                                    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                                </div>
                                <div class="offcanvas-body">
                                    <div id="editBoardFormContainer">
                                        <!-- Loaded dynamically via AJAX -->
                                    </div>
                                </div>
                            </div>

                            <!-- Delete Button -->
                            <form method="post" id="deleteBoardForm-@item.BoardID" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="boardId" value="@item.BoardID" />
                                <button type="button" class="btn btn-sm btn-icon" onclick="showDeleteConfirmation('@item.BoardID', '@item.BoardName')">
                                    <i class="ri-delete-bin-7-line ri-20px"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>