@page
@model SchoolWebApp.Pages.MasterPages.Country.IndexModel
@{
}
@{
    ViewData["Title"] = "Countries";
}

@section VendorStyles
{
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/&#64;form-validation/form-validation.dist.css" />
}

@section VendorScripts
{
    <script src="~/vendor/libs/moment/moment.dist.js"></script>
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.dist.js"></script>
    <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/popular.dist.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/bootstrap5.dist.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/auto-focus.dist.js"></script>
    <script src="~/vendor/libs/cleavejs/cleave.dist.js"></script>
    <script src="~/vendor/libs/cleavejs/cleave-phone.dist.js"></script>
}
@section PageScripts
{
    <script src="~/code_js/managecountry.js"></script>
}

<div class="card">
    <div class="card-header pb-0">
        <h5 class="card-title mb-0">Manage Country</h5>
    </div>
   
    <div class="card-datatable table-responsive">
        <table class="table" id="CountryTable">
            <thead>
                <tr>
                    <th>S.No</th>
                    <th>Country Name</th>
                    <th>Currency Code</th>
                    <th>Decimal</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Countries != null && Model.Countries.Any())
                {
                    var sno = 0;
                    foreach (var country in Model.Countries)
                    {
                        sno = sno + 1; var cont = "country-name-" + country.CountryID;
                        <tr data-id="@country.CountryID">
                            <td>@sno</td>
                            <td class="@cont" >@country.CountryName</td>
                            <td>@country.CurrencyCode</td>
                            <td>@country.CurrencyDecimal</td>
                            <td>
                              
                                <!-- Edit Button -->
                                <button class="btn btn-sm btn-icon"
                                        data-bs-toggle="offcanvas"
                                        data-bs-target="#editCountryOffcanvas"
                                        onclick="editCountry(@country.CountryID)"
                                        data-id="@country.CountryID">
                                    <i class="ri-edit-box-line ri-20px"></i>
                                </button>

                                <!-- Edit Offcanvas -->
                                <div class="offcanvas offcanvas-end" tabindex="-1" id="editCountryOffcanvas" aria-labelledby="editCountryOffcanvasLabel">
                                    <div class="offcanvas-header">
                                        <h5 id="editCountryOffcanvasLabel" class="offcanvas-title">Edit Country</h5>
                                        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                                    </div>
                                    <div class="offcanvas-body">
                                        <div id="editCountryFormContainer"></div>
                                    </div>
                                </div>

                                <!-- Delete Button -->
                                <form method="post" id="deleteCountryForm-@country.CountryID" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@country.CountryID" />
                                    <button type="button" class="btn btn-sm btn-icon" onclick="showDeleteCountryConfirmation('@country.CountryID')">
                                        <i class="ri-delete-bin-7-line ri-20px"></i>
                                    </button>
                                </form>

                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add/Edit Modal -->
@await Html.PartialAsync("_Create")
