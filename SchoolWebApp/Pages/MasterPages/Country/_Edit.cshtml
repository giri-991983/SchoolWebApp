@model SchoolWebApp.Pages.MasterPages.Country.IndexModel

<form id="editCountryForm" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Country.CountryID" />

    <div class="form-floating form-floating-outline mb-4">
        <input asp-for="Country.CountryName" class="form-control" id="EditCountryName" placeholder="Country Name" />
        <label asp-for="Country.CountryName">Country Name</label>
    </div>

    <div class="form-floating form-floating-outline mb-4">
        <input asp-for="Country.CurrencyCode" class="form-control" id="EditCurrencyCode" maxlength="3" placeholder="Currency Code" />
        <label asp-for="Country.CurrencyCode">Currency Code</label>
    </div>

    <div class="form-floating form-floating-outline mb-4">
        <input asp-for="Country.CurrencyDecimal" class="form-control" id="EditCurrencyDecimal" type="number" min="0" max="4" placeholder="Currency Decimal" />
        <label asp-for="Country.CurrencyDecimal">Currency Decimal</label>
    </div>

    <div class="text-end">
        <button type="submit" class="btn btn-primary me-2">Save</button>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">Cancel</button>
    </div>
</form>
