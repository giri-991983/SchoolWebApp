@model SchoolWebApp.Pages.MasterPages.CampusType.IndexModel
<form id="editCampusTypeForm" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="CampusType.CampusTypeID" value="@Model.CampusType.CampusTypeID" />
    <div class="form-floating form-floating-outline mb-5">
        <input type="text" id="editCampusTypeName" name="CampusType.CampusTypeName" class="form-control"
               value="@Model.CampusType.CampusTypeName" required maxlength="50" placeholder="Campus Type Name" />
        <label for="editCampusTypeName">Campus Type Name</label>
        <span id="editcampusTypeNameValidationMessage" class="text-danger"></span>
    </div>
    <div class="text-end">
        <button type="submit" class="btn btn-primary me-2">Save</button>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">Cancel</button>
    </div>
</form>