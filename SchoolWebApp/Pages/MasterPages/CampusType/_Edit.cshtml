@model SchoolWebApp.Pages.MasterPages.CampusType.IndexModel
<form id="editCampusTypeForm" method="post" asp-page-handler="EditCampusType" data-id="@Model.CampusType.CampusTypeID">
    @Html.AntiForgeryToken()
    <input type="hidden" name="CampusType.CampusTypeID" value="@Model.CampusType.CampusTypeID" />
    <div class="modal-body">
        <div class="mb-3">
            <label for="editCampusTypeName" class="form-label fw-medium text-primary">Campus Type Name</label>
            <input type="text" id="editCampusTypeName" name="CampusType.CampusTypeName" class="form-control" value="@Model.CampusType.CampusTypeName" required maxlength="50" />
            <div id="editcampusTypeNameValidationMessage" class="invalid-feedback d-block"></div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-success" id="saveCampusTypeBtn">Save</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
</form>