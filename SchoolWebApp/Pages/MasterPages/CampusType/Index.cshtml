@page
@model SchoolWebApp.Pages.MasterPages.CampusType.IndexModel
@{
    ViewData["Title"] = "Manage Campus Types";
}


@section VendorStyles
{
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/&#64;form-validation/form-validation.dist.css" />
    <link href="~/vendor/libs/select2/select2.dist.css" rel="stylesheet" />


}

@section VendorScripts {
    <script src="~/vendor/libs/moment/moment.dist.js"></script>
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.dist.js"></script>
    <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/popular.dist.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/bootstrap5.dist.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/auto-focus.dist.js"></script>
    <script src="~/vendor/libs/cleavejs/cleave.dist.js"></script>
    <script src="~/vendor/libs/cleavejs/cleave-phone.dist.js"></script>
    <script src="~/vendor/libs/select2/select2.dist.js"></script>

}

@section PageScripts
{
    <script src="~/code_js/managecampustype.js"></script>
}
 

<div class="card">
    <div class="card-datatable table-responsive">
        <div class="container-fluid">
            <h3 class="mb-4">Manage Campus Types</h3>
            <table id="CampusTypeTable" class="table">
                <thead>
                    <tr>
                        <th>S.No</th>
                        <th>Campus Type Name</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.CampusTypes != null && Model.CampusTypes.Any())
                    {
                        var serial = 0;
                        foreach (var item in Model.CampusTypes)
                        {
                            serial++;
                            var tcc = "campustype-name-full-" + item.CampusTypeID;
                            <tr data-id="@item.CampusTypeID">
                                <td>@serial</td>
                                <td class="@tcc">@item.CampusTypeName</td>
                                <td class="text-nowrap">
                                    <div class="col-md-12 d-flex gap-1">
                                        <button type="button"
                                                class="btn btn-sm btn-icon edit-campustype-btn"
                                                onclick="campusTypeEdit(@item.CampusTypeID)"
                                                data-campustype-id="@item.CampusTypeID">
                                            <i class="ri-edit-box-line ri-20px"></i>
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-icon"
                                                onclick="showDeleteConfirmation(@item.CampusTypeID)">
                                            <i class="ri-delete-bin-7-line ri-20px"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center">No Campus Types found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="editCampusTypeOffcanvas" aria-labelledby="editCampusTypeOffcanvasLabel">
    <div class="offcanvas-header">
        <h5 id="editCampusTypeOffcanvasLabel" class="offcanvas-title">Edit Campus Type</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div id="editCampusTypeFormContainer">
            <!-- Loaded dynamically via AJAX -->
        </div>
    </div>
</div>

@await Html.PartialAsync("~/Pages/MasterPages/CampusType/_Create.cshtml", Model.CampusType)