
@model SchoolWebApp.Models.CampusType

<div class="offcanvas offcanvas-end" tabindex="-1" id="createCampusTypeOffcanvas" aria-labelledby="createCampusTypeOffcanvasLabel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="createCampusTypeOffcanvasLabel">Add Campus Type Details</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body mx-0 flex-grow-0">
        <form id="addCampusTypeForm" method="post" asp-page-handler="CreateCampusType">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="CampusTypeID" />

            <div class="form-floating form-floating-outline mb-5">
                <input type="text" asp-for="CampusTypeName" class="form-control" id="CampusTypeName" placeholder="Campus Type Name" maxlength="50" required />
                <label for="CampusTypeName">Campus Type Name</label>
                <span asp-validation-for="CampusTypeName" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-12">
                    <button type="submit" class="btn btn-primary me-3">Submit</button>
                    <button type="reset" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">Cancel</button>
                </div>
            </div>
        </form>
    </div>
</div>
