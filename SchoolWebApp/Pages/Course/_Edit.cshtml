@model SchoolWebApp.Models.CourseYear

<form id="editCourseForm" method="post" enctype="multipart/form-data" data-id="@Model.Course.CourseID">
    @Html.AntiForgeryToken()

    <div class="modal-body">
        <!-- Hidden Fields -->
        <input asp-for="CourseYearID" type="hidden" id="editCourseYearId" />
        <input asp-for="Course.CourseID" type="hidden" id="editCourseId" />

        <!-- Course Name -->
        <div class="mb-3">
            <label asp-for="Course.CourseName" class="form-label fw-medium text-primary"></label>
            <input asp-for="Course.CourseName" class="form-control" id="editCourseName" />
            <span asp-validation-for="Course.CourseName" class="invalid-feedback d-block" id="courseNameValidationMessage"></span>
        </div>

        <!-- Course Year Name -->
        <div class="mb-3">
            <label asp-for="CourseYearName" class="form-label"></label>
            <input asp-for="CourseYearName" class="form-control" id="editCourseYearName" required />
            <span asp-validation-for="CourseYearName" class="invalid-feedback d-block" id="courseYearNameValidationMessage"></span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="submit" class="btn btn-success" id="saveCourseBtn">Save</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
</form>
