@model IEnumerable<SchoolWebApp.Models.CourseYear>

<table id="courseTable" class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>S.No</th>
            <th>Course Name</th>
            <th>Course Year Name</th>
            <th>No. of Years</th>
            <th>No. of Semesters</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            var serial = 0;
            foreach (var courseYear in Model)
            {
                serial++;
                var tcc = "course-name-" + courseYear.CourseID;

                <tr data-courseyear-id="@courseYear.CourseYearID" data-id="@courseYear.CourseID">
                    <td>@serial</td>

                    <td class="@tcc">@courseYear.Course?.CourseName</td>
                    <td>@courseYear.CourseYearName</td>
                    <td>@courseYear.Course?.NoOfYears</td>
                    <td>@courseYear.Course?.NoOfSemesters</td>
                    <td>@Html.Raw(PageHelpers.GetStatusBadge(courseYear.Course?.Status ?? 0))</td>

                    <td class="text-nowrap">
                        <div class="col-md-12">
                            <!-- Edit Button -->
                            <button class="btn btn-sm btn-icon edit-course-btn" onclick="courseEdit(@courseYear.CourseID, @courseYear.CourseYearID)" data-course-id="@courseYear.CourseID">
                                <i class="ri-edit-box-line ri-20px"></i>
                            </button>

                            <!-- Modal -->
                            <div class="modal fade" id="editCourseModal" tabindex="-1" aria-labelledby="editCourseModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-lg">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="editCourseModalLabel">Edit Course Details</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body" id="editCourseFormContainer">
                                            <!-- Edit form will load here via AJAX -->
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Delete Course Year -->
                            <form method="post" id="deleteCourseYearForm-@courseYear.CourseYearID" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="courseYearId" value="@courseYear.CourseYearID" />
                                <button type="button" class="btn btn-sm btn-icon" onclick="showDeleteCourseYearConfirmation('@courseYear.CourseYearID', '@courseYear.Course?.CourseName', '@courseYear.CourseYearName')">
                                    <i class="ri-delete-bin-7-line ri-20px"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
