@page
@model SchoolWebApp.Pages.Account.AccessDeniedModel
@{
    Layout = "Shared/_ContentNavbarLayout";
    ViewData["title"] = "Access denied";
}

<div class="sc-auth">
    <div class="card sc-auth-card">
        <div class="card-body text-center">
            <span class="sc-brand-mark" aria-hidden="true" style="background:linear-gradient(135deg,#ff4c51,#ff8a8d);box-shadow:0 6px 16px rgba(255,76,81,.35)"><i class="ri-lock-2-line"></i></span>
            <h4 class="mb-1">Access denied</h4>
            <p class="text-muted mb-6">This Google account is not allowed to use the admin portal.</p>
            <a class="btn btn-primary w-100" asp-page="/Account/Login">Sign in with a different account</a>
        </div>
    </div>
</div>
