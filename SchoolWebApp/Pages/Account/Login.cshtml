@page
@model SchoolWebApp.Pages.Account.LoginModel
@{
    Layout = "Shared/_ContentNavbarLayout";
    ViewData["title"] = "Sign in";
}

<div class="sc-auth">
    <div class="card sc-auth-card">
        <div class="card-body text-center">
            <span class="sc-brand-mark" aria-hidden="true"><i class="ri-graduation-cap-fill"></i></span>
            <h4 class="mb-1">Welcome to SConnect</h4>
            <p class="text-muted mb-6">Sign in to the school admin portal with your Google account.</p>

            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="alert alert-danger d-flex align-items-center text-start" role="alert">
                    <i class="ri-error-warning-line ri-20px me-2"></i>
                    <span>Google sign-in did not complete. Please try again.</span>
                </div>
            }

            @if (Model.GoogleConfigured)
            {
                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    <button type="submit" class="btn sc-google-btn w-100">
                        <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
                            <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z" />
                            <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" />
                            <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z" />
                            <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z" />
                        </svg>
                        <span>Sign in with Google</span>
                    </button>
                </form>
                <p class="small text-muted mt-5 mb-0"><i class="ri-shield-check-line me-1"></i>Only approved admin accounts can sign in.</p>
            }
            else
            {
                <div class="alert alert-warning text-start mb-0" role="alert">
                    Google sign-in is not configured. Set Authentication:Google:ClientId and
                    Authentication:Google:ClientSecret on the server.
                </div>
            }
        </div>
    </div>
</div>
