@{
  TempData.Keep();
}
<!-- Footer -->
<footer class="content-footer footer bg-footer-theme sc-footer">
  <div class="container-xxl">
    <div class="footer-container d-flex align-items-center justify-content-between py-4 flex-md-row flex-column gap-2">
      <div class="text-body">
        &copy; @DateTime.Now.Year @TempData.Peek("appName") &middot; School administration portal
      </div>
      <div class="text-muted small">
        Signed in as @(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? User.Identity?.Name ?? "guest")
      </div>
    </div>
  </div>
</footer>
<!-- / Footer -->
