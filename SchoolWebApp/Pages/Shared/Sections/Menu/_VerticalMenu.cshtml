@{
    TempData.Keep();
    string currentPage = Convert.ToString(ViewContext.RouteData.Values["page"]) ?? "";

    // (page, label, icon)
    var organisation = new (string Page, string Label, string Icon)[]
    {
        ("/Institution/Index", "Institutions", "ri-government-line"),
        ("/Zone/Index", "Zones", "ri-map-2-line"),
        ("/Campus/Index", "Campuses", "ri-school-line"),
    };
    var academics = new (string Page, string Label, string Icon)[]
    {
        ("/Class/Index", "Classes", "ri-book-2-line"),
        ("/ClassRoom/Index", "Class rooms", "ri-door-open-line"),
        ("/Course/Index", "Courses", "ri-book-open-line"),
        ("/CourseBatch/Index", "Course batches", "ri-group-line"),
    };
    var masters = new (string Page, string Label, string Icon)[]
    {
        ("/MasterPages/AcademicYears/Index", "Academic years", "ri-calendar-2-line"),
        ("/MasterPages/Boards/Index", "Boards", "ri-organization-chart"),
        ("/MasterPages/BoardingTypes/Index", "Boarding types", "ri-home-smile-line"),
        ("/MasterPages/CampusType/Index", "Campus types", "ri-building-line"),
        ("/MasterPages/Country/Index", "Countries", "ri-global-line"),
        ("/MasterPages/State/Index", "States", "ri-map-pin-2-line"),
        ("/MasterPages/City/Index", "Cities", "ri-map-pin-line"),
        ("/MasterPages/FeePaymentMode/Index", "Fee payment modes", "ri-money-rupee-circle-line"),
    };
    bool mastersOpen = currentPage.StartsWith("/MasterPages/", StringComparison.OrdinalIgnoreCase);
}

<!-- Menu -->
<aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme sc-menu">

    <div class="app-brand demo sc-brand">
        <a asp-page="/Index" class="app-brand-link">
            <span class="sc-brand-mark" aria-hidden="true"><i class="ri-graduation-cap-fill"></i></span>
            <span class="sc-brand-text">
                <span class="app-brand-text demo menu-text">@TempData.Peek("appName")</span>
                <small class="sc-brand-tagline">@TempData.Peek("appTagline")</small>
            </span>
        </a>

        <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto" aria-label="Toggle menu">
            <i class="menu-toggle-icon d-xl-block align-middle"></i>
        </a>
    </div>

    <div class="menu-inner-shadow"></div>

    <ul class="menu-inner py-1">

        <li class='menu-item@(currentPage == "/Index" ? " active" : "")'>
            <a asp-page="/Index" class="menu-link">
                <i class="menu-icon tf-icons ri-dashboard-3-line"></i>
                <div>Dashboard</div>
            </a>
        </li>

        <li class="menu-header"><span class="menu-header-text">Organisation</span></li>
        @foreach (var item in organisation)
        {
            <li class='menu-item@(currentPage == item.Page ? " active" : "")'>
                <a asp-page="@item.Page" class="menu-link">
                    <i class="menu-icon tf-icons @item.Icon"></i>
                    <div>@item.Label</div>
                </a>
            </li>
        }

        <li class="menu-header"><span class="menu-header-text">Academics</span></li>
        @foreach (var item in academics)
        {
            <li class='menu-item@(currentPage == item.Page ? " active" : "")'>
                <a asp-page="@item.Page" class="menu-link">
                    <i class="menu-icon tf-icons @item.Icon"></i>
                    <div>@item.Label</div>
                </a>
            </li>
        }

        <li class="menu-header"><span class="menu-header-text">Settings</span></li>
        <li class='menu-item@(mastersOpen ? " active open" : "")'>
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="menu-icon tf-icons ri-settings-4-line"></i>
                <div>Master data</div>
            </a>
            <ul class="menu-sub">
                @foreach (var item in masters)
                {
                    <li class='menu-item@(currentPage == item.Page ? " active" : "")'>
                        <a asp-page="@item.Page" class="menu-link">
                            <div>@item.Label</div>
                        </a>
                    </li>
                }
            </ul>
        </li>
    </ul>

    <div class="sc-menu-footer">
        <form method="post" asp-page="/Account/Logout">
            <button type="submit" class="btn sc-signout w-100">
                <i class="ri-logout-box-r-line me-2"></i><span>Sign out</span>
            </button>
        </form>
    </div>
</aside>
<!-- / Menu -->
