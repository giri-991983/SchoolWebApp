@{
    string displayName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Guest";
    string? email = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
    string initials = string.Concat(displayName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));
    if (string.IsNullOrEmpty(initials)) { initials = "G"; }
}

@* Menu toggle: small screens only *@
@if (ViewData["navbarHideToggle"] == null)
{
    <div class="layout-menu-toggle navbar-nav align-items-xl-center me-3 me-xl-0 d-xl-none">
        <a class="nav-item nav-link px-0" href="javascript:void(0)" aria-label="Open menu">
            <i class="ri-menu-line ri-22px"></i>
        </a>
    </div>
}

<div class="navbar-nav-right d-flex align-items-center" id="navbar-collapse">

    <!-- Page jump: filters the sidebar links -->
    <div class="sc-jump position-relative d-none d-md-block">
        <i class="ri-search-line sc-jump-icon"></i>
        <input type="search" id="sc-jump-input" class="form-control sc-jump-input" placeholder="Jump to a page..." autocomplete="off" aria-label="Jump to a page" />
        <kbd class="sc-jump-kbd">/</kbd>
        <div class="sc-jump-results dropdown-menu" id="sc-jump-results" role="listbox"></div>
    </div>

    <ul class="navbar-nav flex-row align-items-center ms-auto gap-1">

        <li class="nav-item d-none d-lg-flex me-2">
            <span class="sc-date-chip"><i class="ri-calendar-line me-1"></i>@DateTime.Now.ToString("ddd, dd MMM yyyy")</span>
        </li>

        <!-- Style Switcher (structure used by main.js: link, then menu) -->
        <li class="nav-item dropdown-style-switcher dropdown">
            <a class="nav-link btn btn-text-secondary rounded-pill btn-icon dropdown-toggle hide-arrow" href="javascript:void(0);" data-bs-toggle="dropdown" aria-label="Theme">
                <i class='ri-22px'></i>
            </a>
            <ul class="dropdown-menu dropdown-menu-end dropdown-styles">
                <li>
                    <a class="dropdown-item" href="javascript:void(0);" data-theme="light">
                        <span class="align-middle"><i class='ri-sun-line ri-20px me-3'></i>Light</span>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="javascript:void(0);" data-theme="dark">
                        <span class="align-middle"><i class="ri-moon-clear-line ri-20px me-3"></i>Dark</span>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="javascript:void(0);" data-theme="system">
                        <span class="align-middle"><i class="ri-computer-line ri-20px me-3"></i>System</span>
                    </a>
                </li>
            </ul>
        </li>

        <!-- User -->
        <li class="nav-item navbar-dropdown dropdown-user dropdown ms-1">
            <a class="nav-link dropdown-toggle hide-arrow p-0 sc-user-toggle" href="javascript:void(0);" data-bs-toggle="dropdown" aria-label="Account">
                <span class="sc-avatar">@initials</span>
                <span class="sc-user-name d-none d-lg-inline">@displayName</span>
                <i class="ri-arrow-down-s-line d-none d-lg-inline"></i>
            </a>
            <ul class="dropdown-menu dropdown-menu-end mt-3 py-2 sc-user-menu">
                <li class="px-4 py-2">
                    <div class="d-flex align-items-center">
                        <span class="sc-avatar sc-avatar-lg me-3">@initials</span>
                        <div class="flex-grow-1 overflow-hidden">
                            <h6 class="mb-0 text-truncate">@displayName</h6>
                            @if (!string.IsNullOrEmpty(email))
                            {
                                <small class="text-muted text-truncate d-block">@email</small>
                            }
                        </div>
                    </div>
                </li>
                <li><div class="dropdown-divider"></div></li>
                <li>
                    <a class="dropdown-item" asp-page="/Index">
                        <i class="ri-dashboard-3-line ri-20px me-2"></i><span class="align-middle">Dashboard</span>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" asp-page="/MasterPages/AcademicYears/Index">
                        <i class="ri-settings-4-line ri-20px me-2"></i><span class="align-middle">Master data</span>
                    </a>
                </li>
                <li><div class="dropdown-divider"></div></li>
                <li>
                    <div class="d-grid px-4 pt-1 pb-1">
                        <form method="post" asp-page="/Account/Logout" class="d-grid">
                            <button type="submit" class="btn btn-sm btn-label-danger d-flex align-items-center justify-content-center">
                                <i class="ri-logout-box-r-line me-2 ri-16px"></i><span>Sign out</span>
                            </button>
                        </form>
                    </div>
                </li>
            </ul>
        </li>
        <!--/ User -->
    </ul>
</div>
